{
  "root": "..",
  "site_url": "https://didact.digital/",
  "local_pages": [
    "index.html"
  ],
  "localize": {
    "/sideschedule/": "/sideschedule/{lang}/",
    "/talkremind/": "/talkremind/{lang}/",
    "/tonecue/": "/tonecue/{lang}/",
    "/sideschedule/privacy.html": "/sideschedule/{lang}/privacy.html",
    "/talkremind/privacy.html": "/talkremind/{lang}/privacy.html",
    "/tonecue/privacy.html": "/tonecue/{lang}/privacy.html"
  },
  "pages": [
    {
      "src": "index.html",
      "dict": "i18n/home.json",
      "mode": "html"
    }
  ],
  "runtime_var": "HOME_I18N",
  "runtime_keys": [
    "rt.dark",
    "rt.light",
    "rt.open",
    "rt.close",
    "rt.copied",
    "rt.copyfail",
    "rt.typed",
    "rt.dict",
    "rt.desk",
    "rt.connected",
    "rt.calls",
    "rt.meeting"
  ]
}
